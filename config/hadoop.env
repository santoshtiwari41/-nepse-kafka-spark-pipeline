# Converted to Hadoop XML config by the apache/hadoop image (envtoconf.py)
# Format: <FILE>_<property>=<value>

CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020

HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.name.dir=/data/namenode
HDFS-SITE.XML_dfs.datanode.data.dir=/data/datanode
# Single DataNode → no replication possible (production would use 3)
HDFS-SITE.XML_dfs.replication=1
# Simple demo cluster: no HDFS permission checks between users (spark/hadoop)
HDFS-SITE.XML_dfs.permissions.enabled=false
HDFS-SITE.XML_dfs.webhdfs.enabled=true
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true
HDFS-SITE.XML_dfs.datanode.use.datanode.hostname=true
